<!DOCTYPE html>
<html>
<head><title>Tasks</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <div class="container">
    <header>
      <h1><i class="fas fa-tasks"></i>My Tasks</h1>  <!-- 加 Font Awesome 如果想用圖示 -->
      <div class="user-info">Welcome, <%= userId %></div>
    </header>
    
    <section class="add-task-section">
      <a href="/tasks/new" class="btn btn-primary">Add New Task</a>
    </section>
    
    <section class="filter-section">
      <form method="GET">
        <input type="text" name="keyword" placeholder="Search tasks...">
        <select name="priority">
          <option value="">All Priorities</option>
          <option value="low">Low</option>
          <option value="medium">Medium</option>
          <option value="high">High</option>
        </select>
        <button type="submit" class="btn btn-secondary">Filter</button>
      </form>
    </section>
    
    <main class="tasks-dashboard">
      <% if (tasks.length === 0) { %>
        <div class="no-tasks">
          <i class="fas fa-clipboard-list"></i>
          <h3>No Tasks Yet</h3>
          <p>Add your first task to get started!</p>
        </div>
      <% } else { %>
        <% tasks.forEach(task => { %>
          <article class="task-card <%= task.priority %>-priority <%= task.status === 'completed' ? 'completed' : '' %>">
            <div class="task-header">
              <div class="task-title"><%= task.title %></div>
              <span class="task-priority priority-<%= task.priority %>"><%= task.priority.toUpperCase() %></span>
            </div>
            <% if (task.description) { %><p class="task-description"><%= task.description %></p><% } %>
            <div class="task-due-date">
              <i class="fas fa-calendar-alt"></i> Due: <%= task.dueDate ? new Date(task.dueDate).toDateString() : 'No due date' %>
            </div>
            <div class="task-status">Status: <%= task.status %></div>
            <div class="task-actions">
              <a href="/tasks/<%= task._id %>/edit" class="btn btn-primary">Edit</a>
              <form method="POST" action="/tasks/<%= task._id %>?_method=DELETE" style="display:inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete?')">Delete</button>
              </form>
            </div>
          </article>
        <% }); %>
      <% } %>
    </main>
    
    <a href="/auth/logout" class="btn btn-secondary">Logout</a>
  </div>
</body>
</html>
